# Copy this file to .env.local and fill in what you have.
# With nothing but ISSUER_PRIVATE_KEY set, the scripted applicants still run.

# Signs every licence. Any fresh 32-byte hex key. It never holds funds.
ISSUER_PRIVATE_KEY=

# SERV Reasoning, from console.openserv.ai
SERV_API_KEY=
SERV_MODEL=gpt-6-luna

# Dolphin network, from app.dphn.ai
DOLPHIN_API_KEY=

# Reppo evaluation API, from eval.reppo.xyz
REPPO_API_KEY=

# Storage. Leave empty to use a local file under .data
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Turns the licence check into a paid x402 endpoint on Kite
# KITE_PAY_TO is your receiving wallet. KITE_NETWORK is mainnet (default) or testnet.
KITE_PAY_TO=
KITE_NETWORK=

# Live sittings allowed per visitor per day
DAILY_SITTING_LIMIT=6
